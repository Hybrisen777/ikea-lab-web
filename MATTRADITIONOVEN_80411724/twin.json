"tasks":[
 {"title":"Switch on the oven light","text":"Turn the function knob (A, left) to the lamp symbol: the last position (Light).","manualPage":"OVEN_manual_p10","conditions":[{"key":"function","op":"equals","value":"Light"}]},
 {"title":"Forced air at 200 °C","text":"Set knob A to Forced air and the thermostat knob (C, right) to 200. The LED D lights up: preheating has started.","manualPage":"OVEN_manual_p09","conditions":[{"key":"function","op":"equals","value":"ForcedAir"},{"key":"setTemp","op":"equals","value":"200"}]},
 {"title":"Wait for preheating","text":"Wait until LED D switches off - the oven has reached 200 °C. Do not put food in before that.","manualPage":"OVEN_manual_p09","conditions":[{"key":"preheated","op":"equals","value":"yes"}]},
 {"title":"Open the door","text":"Click the door handle. The door opens downwards.","manualPage":null,"conditions":[{"key":"door","op":"equals","value":"open"}]},
 {"title":"Tray on level 2","text":"Click the baking tray on the worktop to slide it onto shelf level 2 (counting from the bottom).","manualPage":"OVEN_manual_p08","conditions":[{"key":"tray","op":"equals","value":"inside"}]},
 {"title":"Close the door, minder 30 min","text":"Close the door, then set the minute minder (B, middle) to 30. It only beeps - it does not switch the oven off.","manualPage":"OVEN_manual_p09","conditions":[{"key":"door","op":"equals","value":"closed"},{"key":"","op":"event","value":"timer:set"},{"key":"timerMin","op":"atLeast","value":"21"},{"key":"timerMin","op":"atMost","value":"30"}]},
 {"title":"Switch the oven off","text":"Turn knob A to 0 and the thermostat C to Off.","manualPage":"OVEN_manual_p09","conditions":[{"key":"function","op":"equals","value":"Off"},{"key":"setTemp","op":"equals","value":"0"}]}],
