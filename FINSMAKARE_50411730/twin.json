"tasks":[
 {"title":"Switch the oven on","text":"Touch On/Off (I/O, left of the shuttle). The display shows the main menu.","manualPage":"FIN_manual_p11","conditions":[{"key":"power","op":"equals","value":"on"}]},
 {"title":"Fill the water drawer","text":"Press the round water drawer cover (right) to open it, click the measuring jug to pour 900 ml, then press the drawer back in.","manualPage":"FIN_manual_p16","conditions":[{"key":"waterMl","op":"atLeast","value":"850"},{"key":"drawer","op":"equals","value":"closed"}]},
 {"title":"True Fan + Steam","text":"Press FUNC (Heating Functions). Turn the shuttle (mouse wheel over it) to True Fan + Steam and click the shuttle (OK).","manualPage":"FIN_manual_p15","conditions":[{"key":"function","op":"equals","value":"TrueFanSteam"}]},
 {"title":"Set 180 °C","text":"Turn the shuttle to 180 °C and click it to confirm.","manualPage":"FIN_manual_p16","conditions":[{"key":"function","op":"equals","value":"TrueFanSteam"},{"key":"setTemp","op":"equals","value":"180"},{"key":"screen","op":"equals","value":"Home"}]},
 {"title":"Duration 30 minutes","text":"Press TIME, turn the shuttle to 0:30 and click OK. The oven switches off by itself when the time is up.","manualPage":"FIN_manual_p18","conditions":[{"key":"","op":"event","value":"duration:set"},{"key":"durationMin","op":"atLeast","value":"25"},{"key":"durationMin","op":"atMost","value":"30"}]},
 {"title":"Wait for the heat-up","text":"Wait until the heat-up bar disappears and the oven beeps 3 times (180 °C reached).","manualPage":"FIN_manual_p12","conditions":[{"key":"preheated","op":"equals","value":"yes"}]},
 {"title":"Open the door carefully","text":"Open the door - stand back, hot steam comes out.","manualPage":"FIN_manual_p16","conditions":[{"key":"door","op":"equals","value":"open"}]},
 {"title":"Close the door and switch off","text":"Close the door and touch On/Off. The display shows the residual heat.","manualPage":"FIN_manual_p17","conditions":[{"key":"door","op":"equals","value":"closed"},{"key":"power","op":"equals","value":"off"}]}],
