"tasks":[
 {"title":"Auto mode","text":"Press (click) the knob on top: AUTO lights and the fan follows the air quality.","manualPage":"STARK_manual_p21","conditions":[{"key":"mode","op":"equals","value":"auto"}]},
 {"title":"Light the candle","text":"Click the candle on the side table and watch PM2.5 climb - Auto speeds the fan up.","manualPage":"STARK_manual_p6","conditions":[{"key":"candle","op":"equals","value":"lit"},{"key":"quality","op":"equals","value":"notgood"}]},
 {"title":"Fixed speed 5","text":"Scroll the wheel over the knob up to speed 5.","manualPage":"STARK_manual_p21","conditions":[{"key":"mode","op":"equals","value":"5"}]},
 {"title":"Blow out the candle","text":"Click the candle again and let the purifier clean the air until it is good again.","manualPage":"STARK_manual_p6","conditions":[{"key":"candle","op":"equals","value":"out"},{"key":"quality","op":"equals","value":"good"}]},
 {"title":"Control lock","text":"Hold the knob for 2 s: the lock LED lights and the knob does nothing.","manualPage":"STARK_manual_p6","conditions":[{"key":"locked","op":"equals","value":"yes"}]},
 {"title":"Unlock and switch off","text":"Hold the knob 2 s again, then click it until the fan stops (Auto -> Off).","manualPage":"STARK_manual_p6","conditions":[{"key":"locked","op":"equals","value":"no"},{"key":"mode","op":"equals","value":"off"}]},
 {"title":"Filter light: unplug","text":"The filter LED is on - check the filter. First pull the power plug at the wall socket.","manualPage":"STARK_manual_p6","conditions":[{"key":"plugged","op":"equals","value":"no"}]},
 {"title":"Remove the front cover","text":"Click the fabric front cover (with the pre-filter grid) to take it off.","manualPage":"STARK_manual_p22","conditions":[{"key":"cover","op":"equals","value":"open"}]},
 {"title":"Swap the filter","text":"Click the particle filter to take it out, then click again to insert a new one.","manualPage":"STARK_manual_p23","conditions":[{"key":"filter","op":"equals","value":"new"}]},
 {"title":"Refit and plug in","text":"Click the cover to refit it, then plug the purifier back in.","manualPage":"STARK_manual_p25","conditions":[{"key":"cover","op":"equals","value":"closed"},{"key":"plugged","op":"equals","value":"yes"}]},
 {"title":"Reset the filter counter","text":"Hold RESET (small key next to the LEDs) for 3 s - the filter LED goes out.","manualPage":"STARK_manual_p6","conditions":[{"key":"filterLed","op":"equals","value":"off"}]}],
